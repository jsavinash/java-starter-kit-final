<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- Suppress generated sources -->
    <suppress files="[\\/]generated[\\/]" checks=".*"/>
    <suppress files="[\\/]build[\\/]generated[\\/]" checks=".*"/>

    <!-- Suppress Javadoc for test classes -->
    <suppress files="[\\/]src[\\/]test[\\/]" checks="JavadocMethod"/>
    <suppress files="[\\/]src[\\/]test[\\/]" checks="JavadocType"/>

    <!-- Suppress DesignForExtension in test classes -->
    <suppress files="[\\/]src[\\/]test[\\/]" checks="DesignForExtension"/>
</suppressions>